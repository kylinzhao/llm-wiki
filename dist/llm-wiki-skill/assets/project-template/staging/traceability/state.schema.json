{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LLM Wiki Traceability State",
  "type": "object",
  "required": ["schema_version", "links"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "updated_at": {
      "type": "string"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "requirement", "source", "code", "strength", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^tr_[A-Za-z0-9_-]+$"
          },
          "requirement": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "code": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "strength": {
            "type": "string",
            "enum": ["strong", "partial", "inferred", "external", "missing"]
          },
          "status": {
            "type": "string",
            "enum": ["proposed", "confirmed", "rejected", "stale"]
          },
          "note": {
            "type": "string"
          },
          "updated_by": {
            "type": "string"
          },
          "decision_note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
